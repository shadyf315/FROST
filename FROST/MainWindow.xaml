<Window x:Class="FROST.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FROST — Рабочий стол" Height="740" Width="1120" MinHeight="660" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        Background="#111713" Foreground="#ECEFE8"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Foreground" Value="#AAB4A8"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style x:Key="PanelBorder" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#202A22"/>
            <Setter Property="BorderBrush" Value="#354236"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#9AA69B"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Фоновая фотография загружается один раз и затем берётся из локального кэша. -->
        <Image x:Name="BackgroundPhoto" Grid.ColumnSpan="2"
               Stretch="UniformToFill" Opacity="0.72"
               IsHitTestVisible="False"/>
        <Border Grid.ColumnSpan="2" Background="#80111713" IsHitTestVisible="False"/>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="222"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#171F19" BorderBrush="#303D32" BorderThickness="0,0,1,0">
            <DockPanel Margin="15,18">
                <StackPanel DockPanel.Dock="Top">
                    <Grid Margin="5,3,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="29" Height="29" CornerRadius="7" Background="#344333" BorderBrush="#58664A" BorderThickness="1">
                            <TextBlock Text="❄" Foreground="#D6B879" FontSize="17"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                            <TextBlock Text="FROST" FontSize="15" FontWeight="SemiBold" Foreground="#F0F1E8"/>
                            <TextBlock Text="ЗИМНЕЕ ОФОРМЛЕНИЕ" FontSize="8" Foreground="#9AA69B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="НАВИГАЦИЯ" Style="{StaticResource SectionLabel}" Margin="11,0,0,8"/>
                    <Button x:Name="OverviewNav" Style="{StaticResource NavButton}" Content="▦   Рабочий стол"
                            Background="#392B2A" BorderBrush="#66444A" Foreground="#E9C9B5" Click="Overview_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="❄   Снег" Click="Snow_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="▤   Обзор окон" Click="MissionControl_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="⊞   Панель запуска" Click="Dock_Click"/>

                    <TextBlock Text="ПРИЛОЖЕНИЕ" Style="{StaticResource SectionLabel}" Margin="11,25,0,8"/>
                    <Button Style="{StaticResource NavButton}" Content="⚙   Настройки" Click="Settings_Click"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="#202A22" BorderBrush="#354236"
                        BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="НОВОГОДНЯЯ ТЕМА" FontSize="9" Foreground="#D6B879" FontWeight="SemiBold"/>
                        <TextBlock Text="Хвоя, тёплый свет и немного зимнего настроения."
                                   TextWrapping="Wrap" Foreground="#ABB5A9" FontSize="10" Margin="0,7,0,0"/>
                        <TextBlock x:Name="VersionLabel" Text="Релиз № 1.0.1" Foreground="#818D82" FontSize="9" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="32,27,32,27">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,23">
                <StackPanel>
                    <TextBlock x:Name="PageEyebrow" Text="FROST / ОБЗОР" Foreground="#D6B879" FontSize="10" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PageTitle" Text="Рабочий стол" FontSize="28" FontWeight="SemiBold" Margin="0,7,0,3"/>
                    <TextBlock x:Name="PageSubtitle" Text="Управляйте эффектами и окнами Windows." Foreground="#A3ADA2" FontSize="12"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#26352A"
                        BorderBrush="#465744" BorderThickness="1" CornerRadius="6" Padding="10,7">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#93B78D" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="ПРИЛОЖЕНИЕ АКТИВНО" FontSize="9" Foreground="#DCE5D5" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="#202C22" BorderBrush="#475340" BorderThickness="1"
                            CornerRadius="10" Padding="23" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" MaxWidth="560">
                                <TextBlock Text="ЗИМНИЙ РЕЖИМ" Foreground="#D28C86" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock Text="Настроение праздника — без лишнего шума."
                                           FontSize="23" FontWeight="SemiBold" Margin="0,10,0,7" TextWrapping="Wrap"/>
                                <TextBlock Text="Включайте снег на рабочем столе, переключайтесь между окнами и запускайте нужные приложения из одной панели."
                                           TextWrapping="Wrap" Foreground="#B0BAAE" FontSize="12" LineHeight="19"/>
                                <Button Content="Настроить снег" HorizontalAlignment="Left" Margin="0,17,0,0"
                                        Background="#D6B879" Foreground="#20251D" BorderBrush="#D6B879"
                                        Click="Snow_Click"/>
                            </StackPanel>
                            <Grid Grid.Column="1" Margin="12,0,0,0">
                                <Ellipse Width="112" Height="112" Fill="#344735" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse Width="78" Height="78" Fill="#4A5140" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="❄" FontSize="54" Foreground="#E2D1A4"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="FROST" FontSize="9" Foreground="#C2C9B5"
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <TextBlock Text="БЫСТРЫЙ ДОСТУП" Style="{StaticResource SectionLabel}" Margin="2,5,0,10"/>
                    <UniformGrid Columns="2" Rows="1" Margin="0,0,0,16">
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,7,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="❄" FontSize="20" Foreground="#C5D9D5"/>
                                    <TextBlock Text="01" HorizontalAlignment="Right" Foreground="#879387" FontSize="10"/>
                                </Grid>
                                <TextBlock Text="Снег на рабочем столе" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                <TextBlock Text="Настройка количества снежинок и скорости падения."
                                           Foreground="#A3ADA2" FontSize="10" TextWrapping="Wrap"/>
                                <Button x:Name="SnowToggle" Content="Включить снег" HorizontalAlignment="Left"
                                        Margin="0,15,0,0" Click="ToggleSnow_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}" Margin="7,0,0,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="▤" FontSize="20" Foreground="#D6B879"/>
                                    <TextBlock Text="02" HorizontalAlignment="Right" Foreground="#879387" FontSize="10"/>
                                </Grid>
                                <TextBlock Text="Обзор открытых окон" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                <TextBlock Text="Список открытых окон с быстрым переключением между ними."
                                           Foreground="#A3ADA2" FontSize="10" TextWrapping="Wrap"/>
                                <Button Content="Открыть обзор" HorizontalAlignment="Left"
                                        Margin="0,15,0,0" Click="MissionControl_Click"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock Text="СОЧЕТАНИЯ КЛАВИШ" Style="{StaticResource SectionLabel}" Margin="2,4,0,10"/>
                    <Border Style="{StaticResource PanelBorder}" Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Открыть обзор окон" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="Ctrl + Alt + M" Foreground="#D6B879" FontSize="10"/>
                            <TextBlock Grid.Row="1" Text="Включить или выключить снег" FontSize="11" Margin="0,10,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Ctrl + Alt + N" Foreground="#D6B879" FontSize="10" Margin="0,10,0,0"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>