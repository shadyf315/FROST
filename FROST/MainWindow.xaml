<Window x:Class="FROST.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FROST" Height="780" Width="1180" MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#090D16" Foreground="#F2F6FC"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="13,11"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Foreground" Value="#9AA9BC"/>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#202E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0D1421" BorderBrush="#1C293B" BorderThickness="0,0,1,0">
            <DockPanel Margin="18,22">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="5,2,0,34">
                        <Border Width="38" Height="38" CornerRadius="13" Background="#19334B">
                            <TextBlock Text="❄" FontSize="23" Foreground="#A9DCFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="FROST" FontSize="18" FontWeight="Bold" CharacterSpacing="140"/>
                            <TextBlock Text="DESKTOP EXPERIENCE" FontSize="9" Foreground="#71839B" CharacterSpacing="90"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="WORKSPACE" FontSize="10" Foreground="#65758B" FontWeight="SemiBold" Margin="12,0,0,9" CharacterSpacing="110"/>
                    <Button x:Name="OverviewNav" Style="{StaticResource NavButton}" Content="◫   Overview" Background="#1A2B40" Foreground="#EAF5FF" Click="Overview_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="❄   Snow" Click="Snow_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="▦   Mission Control" Click="MissionControl_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="▤   Dock" Click="Dock_Click"/>
                    <TextBlock Text="PREFERENCES" FontSize="10" Foreground="#65758B" FontWeight="SemiBold" Margin="12,25,0,9" CharacterSpacing="110"/>
                    <Button Style="{StaticResource NavButton}" Content="⚙   Settings" Click="Settings_Click"/>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="#121E2D" CornerRadius="13" Padding="13" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="FROST PREVIEW" FontSize="10" Foreground="#8BCBFF" FontWeight="Bold" CharacterSpacing="80"/>
                        <TextBlock Text="Your desktop, with a little winter magic." TextWrapping="Wrap" Foreground="#9AA9BC" FontSize="11" Margin="0,7,0,0"/>
                        <TextBlock Text="Build 0.1.0 · Early access" Foreground="#62748B" FontSize="10" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="34,28,34,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,25">
                <StackPanel>
                    <TextBlock x:Name="PageEyebrow" Text="YOUR WINDOWS, REIMAGINED" Foreground="#8BCBFF" FontSize="10" FontWeight="Bold" CharacterSpacing="130"/>
                    <TextBlock x:Name="PageTitle" Text="Good evening." FontSize="31" FontWeight="SemiBold" Margin="0,7,0,3"/>
                    <TextBlock x:Name="PageSubtitle" Text="A calmer, more considered desktop starts here." Foreground="#91A0B4" FontSize="13"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#132235" BorderBrush="#263B54" BorderThickness="1" CornerRadius="20" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#7FE0B1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="SYSTEM READY" FontSize="10" Foreground="#B9C8D9" FontWeight="SemiBold" CharacterSpacing="65"/>
                    </StackPanel>
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardBorder}" Padding="25" Margin="0,0,0,17">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" MaxWidth="540">
                                <TextBlock Text="A NEW WAY TO SEE YOUR DESKTOP" Foreground="#8BCBFF" FontSize="10" FontWeight="Bold" CharacterSpacing="100"/>
                                <TextBlock Text="Winter, meet workflow." FontSize="27" FontWeight="SemiBold" Margin="0,10,0,7"/>
                                <TextBlock Text="Bring a touch of macOS-inspired atmosphere to Windows. Add gentle snowfall, explore your open windows, and make the desktop feel like yours." TextWrapping="Wrap" Foreground="#A0AEC0" FontSize="13" LineHeight="21"/>
                                <Button Content="Explore Mission Control  →" HorizontalAlignment="Left" Margin="0,20,0,0" Background="#D7EDFF" Foreground="#102033" BorderBrush="#D7EDFF" FontWeight="SemiBold" Click="MissionControl_Click"/>
                            </StackPanel>
                            <Grid Grid.Column="1" Width="190" Height="160" Margin="18,0,0,0">
                                <Ellipse Width="145" Height="145" Fill="#183B58" Opacity="0.55"/>
                                <Ellipse Width="105" Height="105" Fill="#245477" Opacity="0.55"/>
                                <TextBlock Text="❄" FontSize="91" Foreground="#C4E8FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="01 / WINTER MODE" FontSize="9" Foreground="#9CC9EA" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" CharacterSpacing="100"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <TextBlock Text="QUICK CONTROLS" FontSize="10" Foreground="#71839B" FontWeight="Bold" CharacterSpacing="120" Margin="2,5,0,12"/>
                    <UniformGrid Columns="2" Rows="1" Margin="0,0,0,17">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                            <StackPanel>
                                <Grid><TextBlock Text="❄" FontSize="21" Foreground="#A9DCFF"/><TextBlock Text="01" HorizontalAlignment="Right" Foreground="#63758B" FontSize="11"/></Grid>
                                <TextBlock Text="Snowfall" FontSize="17" FontWeight="SemiBold" Margin="0,13,0,4"/>
                                <TextBlock Text="A quiet snowfall across your desktop." Foreground="#91A0B4" FontSize="11" TextWrapping="Wrap"/>
                                <Button x:Name="SnowToggle" Content="Enable snowfall" HorizontalAlignment="Left" Margin="0,17,0,0" Click="ToggleSnow_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                            <StackPanel>
                                <Grid><TextBlock Text="▦" FontSize="21" Foreground="#A9DCFF"/><TextBlock Text="02" HorizontalAlignment="Right" Foreground="#63758B" FontSize="11"/></Grid>
                                <TextBlock Text="Mission Control" FontSize="17" FontWeight="SemiBold" Margin="0,13,0,4"/>
                                <TextBlock Text="See your open windows in one clear view." Foreground="#91A0B4" FontSize="11" TextWrapping="Wrap"/>
                                <Button Content="Open overview  →" HorizontalAlignment="Left" Margin="0,17,0,0" Click="MissionControl_Click"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock Text="DESIGNED TO FEEL AT HOME" FontSize="10" Foreground="#71839B" FontWeight="Bold" CharacterSpacing="120" Margin="2,5,0,12"/>
                    <Border Style="{StaticResource CardBorder}" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="12" Background="#1A3047"><TextBlock Text="✧" FontSize="24" Foreground="#A9DCFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" Margin="13,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="Subtle by design" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Effects are built to stay out of your way." Foreground="#91A0B4" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="FROST / 001" Foreground="#65758B" FontSize="9" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
