<Window x:Class="FROST.Views.SnowSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FROST — Snowfall" Width="520" Height="470"
        MinWidth="480" MinHeight="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#090D16" Foreground="#F2F6FC"
        FontFamily="Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="FROST / ATMOSPHERE" Foreground="#8BCBFF" FontSize="10" FontWeight="Bold"/>
            <TextBlock Text="Snowfall" FontSize="29" FontWeight="SemiBold" Margin="0,8,0,4"/>
            <TextBlock Text="A soft layer of snow across your entire desktop." Foreground="#91A0B4" FontSize="12"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,28,0,0">
            <Border Background="#111827" BorderBrush="#202E42" BorderThickness="1" CornerRadius="15" Padding="18">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Snowfall density" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DensityValue" Text="85 flakes" HorizontalAlignment="Right" Foreground="#A9DCFF"/>
                    </Grid>
                    <Slider x:Name="DensitySlider" Minimum="10" Maximum="220" Value="85" TickFrequency="10" IsSnapToTickEnabled="False" Margin="0,15,0,4" ValueChanged="Settings_ValueChanged"/>
                    <TextBlock Text="How many snowflakes appear at once." Foreground="#8191A6" FontSize="11"/>
                </StackPanel>
            </Border>
            <Border Background="#111827" BorderBrush="#202E42" BorderThickness="1" CornerRadius="15" Padding="18" Margin="0,13,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Fall speed" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SpeedValue" Text="1.0×" HorizontalAlignment="Right" Foreground="#A9DCFF"/>
                    </Grid>
                    <Slider x:Name="SpeedSlider" Minimum="0.2" Maximum="3" Value="1" TickFrequency="0.1" Margin="0,15,0,4" ValueChanged="Settings_ValueChanged"/>
                    <TextBlock Text="Adjust the movement from gentle to lively." Foreground="#8191A6" FontSize="11"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="StatusText" Text="Snowfall is currently disabled." Foreground="#91A0B4" FontSize="11" Margin="2,17,0,0"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Button Content="Close" HorizontalAlignment="Right" MinWidth="100" Click="Close_Click"/>
            <Button x:Name="ToggleButton" Content="Enable snowfall" HorizontalAlignment="Left" MinWidth="150" Background="#D7EDFF" Foreground="#102033" BorderBrush="#D7EDFF" FontWeight="SemiBold" Click="Toggle_Click"/>
        </Grid>
    </Grid>
</Window>
