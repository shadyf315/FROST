<Window x:Class="FROST.Views.SnowSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FROST — Снег" Width="520" Height="470"
        MinWidth="480" MinHeight="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#111713" Foreground="#ECEFE8"
        FontFamily="Segoe UI">
    <Grid Margin="27">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="FROST / ЭФФЕКТЫ" Foreground="#D6B879" FontSize="10" FontWeight="SemiBold"/>
            <TextBlock Text="Снег на рабочем столе" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,4"/>
            <TextBlock Text="Настройте плотность и скорость падения снежинок." Foreground="#A3ADA2" FontSize="12"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,26,0,0">
            <Border Background="#202A22" BorderBrush="#354236" BorderThickness="1" CornerRadius="9" Padding="17">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Количество снежинок" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DensityValue" Text="85" HorizontalAlignment="Right" Foreground="#D6B879"/>
                    </Grid>
                    <Slider x:Name="DensitySlider" Minimum="10" Maximum="220" Value="85" TickFrequency="10"
                            IsSnapToTickEnabled="False" Margin="0,15,0,4" ValueChanged="Settings_ValueChanged"/>
                    <TextBlock Text="Чем выше значение, тем плотнее снегопад." Foreground="#9AA69B" FontSize="11"/>
                </StackPanel>
            </Border>
            <Border Background="#202A22" BorderBrush="#354236" BorderThickness="1" CornerRadius="9" Padding="17" Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Скорость падения" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SpeedValue" Text="1,0×" HorizontalAlignment="Right" Foreground="#D6B879"/>
                    </Grid>
                    <Slider x:Name="SpeedSlider" Minimum="0.2" Maximum="3" Value="1" TickFrequency="0.1"
                            Margin="0,15,0,4" ValueChanged="Settings_ValueChanged"/>
                    <TextBlock Text="От медленного снегопада до более быстрого." Foreground="#9AA69B" FontSize="11"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="StatusText" Text="Снег выключен." Foreground="#A3ADA2" FontSize="11" Margin="2,16,0,0"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Button Content="Закрыть" HorizontalAlignment="Right" MinWidth="100" Click="Close_Click"/>
            <Button x:Name="ToggleButton" Content="Включить снег" HorizontalAlignment="Left" MinWidth="145"
                    Background="#D6B879" Foreground="#20251D" BorderBrush="#D6B879"
                    FontWeight="SemiBold" Click="Toggle_Click"/>
        </Grid>
    </Grid>
</Window>