<Window x:Class="FROST.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FROST — Панель запуска" Width="410" Height="94"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" WindowStartupLocation="Manual"
        FontFamily="Segoe UI">
    <Border Background="#F01B241C" BorderBrush="#6574514B" BorderThickness="1"
            CornerRadius="15" Padding="8" Margin="7">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.32" Color="#080B08"/>
        </Border.Effect>
        <UniformGrid Columns="5">
            <Button Background="Transparent" BorderBrush="Transparent" Padding="5" Click="Explorer_Click">
                <StackPanel>
                    <TextBlock Text="▰" FontSize="22" Foreground="#D6B879" HorizontalAlignment="Center"/>
                    <TextBlock Text="Проводник" FontSize="9" Foreground="#E5E9DF" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </Button>
            <Button Background="Transparent" BorderBrush="Transparent" Padding="5" Click="Notepad_Click">
                <StackPanel>
                    <TextBlock Text="▤" FontSize="22" Foreground="#C5D9D5" HorizontalAlignment="Center"/>
                    <TextBlock Text="Блокнот" FontSize="9" Foreground="#E5E9DF" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </Button>
            <Button Background="Transparent" BorderBrush="Transparent" Padding="5" Click="Calculator_Click">
                <StackPanel>
                    <TextBlock Text="▦" FontSize="22" Foreground="#C5D9D5" HorizontalAlignment="Center"/>
                    <TextBlock Text="Калькулятор" FontSize="9" Foreground="#E5E9DF" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </Button>
            <Button Background="Transparent" BorderBrush="Transparent" Padding="5" Click="Settings_Click">
                <StackPanel>
                    <TextBlock Text="⚙" FontSize="22" Foreground="#D6B879" HorizontalAlignment="Center"/>
                    <TextBlock Text="Параметры" FontSize="9" Foreground="#E5E9DF" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </Button>
            <Button Background="Transparent" BorderBrush="Transparent" Padding="5" Click="Close_Click">
                <StackPanel>
                    <TextBlock Text="×" FontSize="22" Foreground="#C78B87" HorizontalAlignment="Center"/>
                    <TextBlock Text="Скрыть" FontSize="9" Foreground="#E5E9DF" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </Button>
        </UniformGrid>
    </Border>
</Window>