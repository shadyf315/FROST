<Window x:Class="FROST.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FROST Dock" Width="390" Height="94"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="True"
        Topmost="True" WindowStartupLocation="Manual"
        FontFamily="Segoe UI">
    <Border Background="#E9162233" BorderBrush="#526E8CA8" BorderThickness="1"
            CornerRadius="22" Padding="10" Margin="7">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.38"/>
        </Border.Effect>
        <UniformGrid Columns="4">
            <Button Background="Transparent" BorderThickness="0" Padding="5" Click="Explorer_Click">
                <StackPanel>
                    <TextBlock Text="📁" FontSize="25" HorizontalAlignment="Center"/>
                    <TextBlock Text="Explorer" FontSize="10" Foreground="#DCE8F5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </Button>
            <Button Background="Transparent" BorderThickness="0" Padding="5" Click="Notepad_Click">
                <StackPanel>
                    <TextBlock Text="▤" FontSize="25" Foreground="#B8DFFF" HorizontalAlignment="Center"/>
                    <TextBlock Text="Notepad" FontSize="10" Foreground="#DCE8F5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </Button>
            <Button Background="Transparent" BorderThickness="0" Padding="5" Click="Calculator_Click">
                <StackPanel>
                    <TextBlock Text="▦" FontSize="25" Foreground="#B8DFFF" HorizontalAlignment="Center"/>
                    <TextBlock Text="Calculator" FontSize="10" Foreground="#DCE8F5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </Button>
            <Button Background="Transparent" BorderThickness="0" Padding="5" Click="Settings_Click">
                <StackPanel>
                    <TextBlock Text="⚙" FontSize="25" Foreground="#B8DFFF" HorizontalAlignment="Center"/>
                    <TextBlock Text="Settings" FontSize="10" Foreground="#DCE8F5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </Button>
        </UniformGrid>
    </Border>
</Window>
