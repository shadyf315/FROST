<Window x:Class="FROST.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FROST — Настройки" Width="620" Height="560"
        MinWidth="560" MinHeight="500" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#111713" Foreground="#ECEFE8"
        FontFamily="Segoe UI">
    <Grid Margin="27">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="FROST / ПРИЛОЖЕНИЕ" Foreground="#D6B879" FontSize="10" FontWeight="SemiBold"/>
            <TextBlock Text="Настройки" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,4"/>
            <TextBlock Text="Сведения о версии, сочетаниях клавиш и локальных данных." Foreground="#A3ADA2" FontSize="12"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,24,0,0">
            <Border Background="#202A22" BorderBrush="#354236" BorderThickness="1" CornerRadius="9" Padding="17">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="FROST" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AppVersionText" Text="Релиз № 1.0.1" Foreground="#9AA69B" FontSize="11" Margin="0,5,0,0"/>
                        <TextBlock Text="Приложение для Windows 10 и Windows 11." Foreground="#9AA69B" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="#344333">
                        <TextBlock Text="❄" FontSize="23" Foreground="#D6B879"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <TextBlock Text="СОЧЕТАНИЯ КЛАВИШ" Foreground="#9AA69B" FontSize="10" FontWeight="SemiBold" Margin="3,21,0,9"/>
            <Border Background="#202A22" BorderBrush="#354236" BorderThickness="1" CornerRadius="9" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Открыть обзор окон" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Ctrl + Alt + M" Foreground="#D6B879" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Text="Включить или выключить снег" FontSize="12" VerticalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Ctrl + Alt + N" Foreground="#D6B879" FontSize="11" VerticalAlignment="Center" Margin="0,12,0,0"/>
                </Grid>
            </Border>

            <TextBlock Text="ЛОКАЛЬНЫЕ ДАННЫЕ" Foreground="#9AA69B" FontSize="10" FontWeight="SemiBold" Margin="3,21,0,9"/>
            <Border Background="#202A22" BorderBrush="#354236" BorderThickness="1" CornerRadius="9" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Настройки хранятся на этом компьютере" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="%AppData%\FROST\settings.json" Foreground="#9AA69B" FontSize="10" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Открыть папку" VerticalAlignment="Center" Click="OpenFolder_Click"/>
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,17,0,0">
            <TextBlock x:Name="SystemVersion" Foreground="#879387" FontSize="10" VerticalAlignment="Center"/>
            <Button Content="Готово" HorizontalAlignment="Right" MinWidth="90" Click="Done_Click"/>
        </Grid>
    </Grid>
</Window>