<Window x:Class="FROST.Views.OverviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FROST — Обзор окон" Width="900" Height="650"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#111713" Foreground="#ECEFE8"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#29372B"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3A3330"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="27">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="FROST / ОКНА" Foreground="#D6B879" FontSize="10" FontWeight="SemiBold"/>
                <TextBlock Text="Обзор окон" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,4"/>
                <TextBlock Text="Выберите окно, чтобы перейти к нему." Foreground="#A3ADA2" FontSize="12"/>
            </StackPanel>
            <Button Content="↻  Обновить" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Refresh_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,22,0,12">
            <TextBlock x:Name="WindowCount" Text="ОТКРЫТЫЕ ОКНА" Foreground="#9AA69B" FontSize="10" FontWeight="SemiBold"/>
            <TextBlock x:Name="LastUpdated" HorizontalAlignment="Right" Foreground="#879387" FontSize="10"/>
        </Grid>

        <Grid Grid.Row="2">
            <ListBox x:Name="WindowList" SelectionChanged="WindowList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#202A22" BorderBrush="#354236" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="7" Background="#344333">
                                    <TextBlock Text="▣" Foreground="#D6B879" FontSize="17"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,10,0">
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding ProcessName}" Foreground="#9AA69B" FontSize="10" Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="↗" FontSize="17" Foreground="#D6B879" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="▤" FontSize="38" Foreground="#718071" HorizontalAlignment="Center"/>
                <TextBlock Text="Открытых окон не найдено" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,5" HorizontalAlignment="Center"/>
                <TextBlock Text="Откройте приложение и обновите список." Foreground="#9AA69B" FontSize="11" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="Нажмите на строку, чтобы переключиться на окно." Foreground="#9AA69B" FontSize="10" VerticalAlignment="Center"/>
            <Button Content="Закрыть" HorizontalAlignment="Right" MinWidth="90" Click="Done_Click"/>
        </Grid>
    </Grid>
</Window>